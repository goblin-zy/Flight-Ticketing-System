# ---------- 1. 目录忽略 (文件夹) ----------
# 你的构建目录 (必删)
build/

# 你提到的那个奇怪的 bin 文件夹 (必删)
# 解释：这是编译生成的产物或者是部署目录，不需要上传源码副本
bin/

# 如果 FluentUI 内部也有构建生成的临时文件夹，也可以在这里加
FluentUI/build/
FluentUI/bin/

# ---------- 2. 文件忽略 (特定类型) ----------
# Qt Creator 用户个人配置文件 (必删，这是你本地的绝对路径配置)
CMakeLists.txt.user
*.user

# 编译生成的库文件 (之前报错的 195MB 文件就在这)
*.a
*.lib
*.dll
*.so
*.dylib

# 可执行文件 (之前报错的 140MB 文件)
*.exe

# 编译中间文件 (对象文件等)
*.o
*.obj
*.moc
*.pch

# ---------- 3. 系统垃圾文件 ----------
.DS_Store
Thumbs.db

# ---------- 4. 保护性规则 (确保这些永远不会被忽略) ----------
# 即使上面写错了，下面这些也会强制保留 (可选，为了安心)
!src/
!ui/
!FluentUI/
!CMakeLists.txt
!main.cpp